# Application Configuration Example
SPRING_APPLICATION_NAME=second-life
SERVER_PORT=8080

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/secondlife_db
DB_PORT=5432
DB_NAME=secondlife_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Flyway Migration
FLYWAY_ENABLED=true

# Security & JWT (256-bit hexadecimal string)
JWT_SECRET=your_256_bit_secret_hex_string_here_min_64_characters_long
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Mail Configuration (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_FROM=noreply@example.com
MAIL_PASSWORD=your_smtp_app_password_here
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=your_google_oauth2_client_id_here.apps.googleusercontent.com

# Token Lifespans
EMAIL_VERIFICATION_EXPIRATION_MS=86400000
PASSWORD_RESET_EXPIRATION_MS=3600000

# Seeder Configuration
SEEDER_ENABLED=false

# Admin Seeder
SEED_ADMIN_ENABLED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=YourAdminStrongPassword@123
SEED_ADMIN_FULL_NAME=System Administrator

# Seller Seeder
SEED_SELLER_ENABLED=true
SEED_SELLER_EMAIL=seller@secondlife.com
SEED_SELLER_PASSWORD=seller@123456
SEED_SELLER_FULL_NAME=Verified Seller

# Spring AI Ollama
SPRING_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
SPRING_AI_OLLAMA_CHAT_MODEL=gemma4:31b-cloud

# Spring AI Google GenAI
GOOGLE_API_KEY=your_google_genai_api_key_here
SPRING_AI_GOOGLE_GENAI_CHAT_MODEL=gemini-3.5-flash-lite

# Banner Configuration
SPRING_BANNER_LOCATION=classpath:banner.txt
SPRING_MAIN_BANNER_MODE=console

# eKYC Configuration (VNPT eKYC Provider)
VNPT_EKYC_PROVIDER=VNPT
VNPT_EKYC_API_BASE_URL=https://api.vnpt.vn
VNPT_EKYC_TOKEN_URL=https://api.vnpt.vn/oauth/token
VNPT_EKYC_APP_CLIENT_ID=your_vnpt_app_client_id
VNPT_EKYC_APP_CLIENT_SECRET=your_vnpt_app_client_secret
VNPT_EKYC_SERVER_CLIENT_ID=your_vnpt_server_client_id
VNPT_EKYC_SERVER_CLIENT_SECRET=your_vnpt_server_client_secret
VNPT_EKYC_TIMEOUT_MS=5000
VNPT_EKYC_MAX_RETRIES=2
VNPT_EKYC_MAX_RESUBMISSIONS=3

# Seller Risk Decision Engine
RISK_DUPLICATE_CHECK_ENABLED=true
RISK_SELLER_REVIEW_THRESHOLD=70.0

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Multipart File Upload Limits
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=30MB
