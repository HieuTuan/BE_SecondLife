# Application Configuration Example
SPRING_APPLICATION_NAME=
SERVER_PORT=

# Database (PostgreSQL)
DB_URL=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JPA / Hibernate
JPA_DDL_AUTO=
JPA_SHOW_SQL=
JPA_FORMAT_SQL=

# Flyway Migration
FLYWAY_ENABLED=

# Security & JWT (256-bit hexadecimal string)
# Permission checks are always enabled; APP_SECURITY_PERMISSIONS_ENABLED is deprecated.
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=

# Mail Configuration (SMTP)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS_ENABLE=
MAIL_SMTP_STARTTLS_REQUIRED=
MAIL_SMTP_CONNECTION_TIMEOUT=
MAIL_SMTP_TIMEOUT=
MAIL_SMTP_WRITE_TIMEOUT=

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=

# Token Lifespans
EMAIL_VERIFICATION_EXPIRATION_MS=
PASSWORD_RESET_EXPIRATION_MS=

# Seeder Configuration
SEEDER_ENABLED=

# Admin Seeder
SEED_ADMIN_ENABLED=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=

# Seller Seeder
SEED_SELLER_ENABLED=
SEED_SELLER_EMAIL=
SEED_SELLER_PASSWORD=
SEED_SELLER_FULL_NAME=
SEED_BUYER_ENABLED=false
SEED_BUYER_EMAIL=
SEED_BUYER_PASSWORD=
SEED_BUYER_FULL_NAME=

# Spring AI Ollama
SPRING_AI_OLLAMA_BASE_URL=
SPRING_AI_OLLAMA_CHAT_MODEL=

# Spring AI Google GenAI
GOOGLE_API_KEY=
SPRING_AI_GOOGLE_GENAI_CHAT_MODEL=

# Banner Configuration
SPRING_BANNER_LOCATION=
SPRING_MAIN_BANNER_MODE=

# eKYC Configuration (VNPT eKYC Provider)
VNPT_EKYC_PROVIDER=
# VNPT OAuth credentials and API keys. Keep values on the backend.
VNPT_CLIENT_ID=
VNPT_CLIENT_SECRET=
VNPT_TOKEN_ID=
VNPT_TOKEN_KEY=
VNPT_BASE_URL=https://api.idg.vnpt.vn
VNPT_MAC_ADDRESS=TEST1
# Legacy variables below are supported as fallbacks for existing local setups.
VNPT_EKYC_API_BASE_URL=
VNPT_EKYC_TOKEN_ID=
VNPT_EKYC_TOKEN_KEY=
VNPT_EKYC_SERVER_CLIENT_ID=
VNPT_EKYC_SERVER_CLIENT_SECRET=
VNPT_EKYC_TIMEOUT_MS=
VNPT_EKYC_MAX_RETRIES=
VNPT_EKYC_MAX_RESUBMISSIONS=
VNPT_EKYC_RECOVERY_ENABLED=
VNPT_EKYC_RECOVERY_INTERVAL_MS=
VNPT_EKYC_RECOVERY_DELAY_MS=
VNPT_EKYC_RECOVERY_MAX_ATTEMPTS=
VNPT_EKYC_RECOVERY_BATCH_SIZE=

# Seller Risk Decision Engine
RISK_DUPLICATE_CHECK_ENABLED=
RISK_SELLER_REVIEW_THRESHOLD=

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Multipart File Upload Limits
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=

# Local mock payment callback only. Keep webhook secret server-side (32+ characters).
PAYMENT_MOCK_CALLBACK_ENABLED=
PAYMENT_MOCK_WEBHOOK_SECRET=
